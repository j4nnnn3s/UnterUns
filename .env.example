# Process environment for a public UnterUns host.
# The server does not load this file. Export the variables yourself.
# Leave PUBLIC_URL and TRUST_PROXY unset for local LAN hosting.

# Bind address. 0.0.0.0 accepts phones on the LAN.
# Use 127.0.0.1 when a reverse proxy on this machine is the only public entry.
HOST=0.0.0.0

# Port the proxy forwards to. LAN QR codes use this port when PUBLIC_URL is unset.
PORT=4173

# Public origin players open and share. No path, query, or trailing slash.
# Changing domains later means changing this value and the proxy site block.
# PUBLIC_URL=https://example.com

# true only behind a proxy that sets X-Forwarded-Proto, X-Forwarded-Host,
# and X-Forwarded-For. Forged forwarded headers are ignored when this is false.
TRUST_PROXY=false

# Optional. When set, Create game asks for this password.
# HOST_PASSWORD=change-me

# Defaults below are enough for a house party, including several tabs on one IP.
# WS_MAX_PAYLOAD_BYTES=65536
# WS_HEARTBEAT_MS=30000
# MAX_ROOMS=100
# MAX_PLAYERS=24
# MAX_CONNECTIONS_PER_IP=48
# MAX_NAME_LENGTH=16
# ROOM_CREATE_LIMIT=30
# ROOM_CREATE_WINDOW_MS=3600000
# JOIN_LIMIT=120
# JOIN_WINDOW_MS=600000
# GUESS_LIMIT=30
# GUESS_WINDOW_MS=600000
